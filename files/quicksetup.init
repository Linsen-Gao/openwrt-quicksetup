#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

# 仅在检测到有效物理终端时才启动服务，避免在 headless 系统上不断重试
start_service() {
    local tty_active=""
    # 检查是否有活跃的物理/串口 TTY
    for tty_dev in /dev/tty1 /dev/ttyS0 /dev/ttyAMA0 /dev/tty0; do
        if [ -c "$tty_dev" ]; then
            tty_active="$tty_dev"
            break
        fi
    done

    if [ -z "$tty_active" ]; then
        return 0
    fi

    procd_open_instance
    procd_set_param command /usr/sbin/quicksetup
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger quicksetup
}